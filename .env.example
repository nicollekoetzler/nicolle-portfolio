# Project Discovery & Budget Estimator (/contact)
# Copy to .env.local for local development, and add the same keys in Vercel → Project → Settings → Environment Variables.

# AI: reads the project description, writes the tailored follow-up question and the brief.
# Without it the estimator still works, using the built-in heuristics in app/components/estimator/engine.ts.
ANTHROPIC_API_KEY=
# Optional, defaults to claude-haiku-5-5
ANTHROPIC_MODEL=

# Email delivery of finished briefs (https://resend.com). Without it, "Send inquiry" opens the visitor's email app
# with the brief written out.
RESEND_API_KEY=
# Optional: where briefs go (defaults to hello@nicollekoetzler.com) and the sender, on a domain verified in Resend
INQUIRY_TO=
INQUIRY_FROM="Project Estimator <estimator@nicollekoetzler.com>"
